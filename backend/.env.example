# --- Database ---
DATABASE_URL=postgresql+asyncpg://thesisguard:thesisguard@localhost:5432/thesisguard

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM (team이 provider를 정한 뒤 채운다) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- MCP / 외부 데이터 소스 ---
# SEC EDGAR는 API 키가 필요 없지만, 요청마다 연락 가능한 User-Agent를 요구한다.
SEC_USER_AGENT="ThesisGuard PBL Team <you@example.com>"
# FRED 그래프 CSV 엔드포인트는 키 없이 조회 가능 (거시 데이터: CPI/기준금리/국채금리)
FRED_BASE_URL=https://fred.stlouisfed.org/graph/fredgraph.csv
# 시세는 키 없이 조회 가능한 Yahoo Finance 차트 API 사용 (mcp_tools/market.py에 하드코딩)

# --- 이메일(Alert Engine) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@thesisguard.local
SMTP_USE_TLS=true
# true로 두면 실제 발송 대신 로그로만 출력 (로컬 개발용)
EMAIL_DRY_RUN=true
