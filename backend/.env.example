# --- Database ---
# Zero-setup local development: sqlite+aiosqlite:///./thesisguard.db
# Team/production PostgreSQL:
DATABASE_URL=postgresql+asyncpg://thesisguard:thesisguard@localhost:5432/thesisguard

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth Client ID (Google Cloud Console > APIs & Services > Credentials
# > Create Credentials > OAuth client ID > Web application). Must be the SAME
# value as frontend/.env.local's NEXT_PUBLIC_GOOGLE_CLIENT_ID — the backend
# uses it only to verify the "aud" claim on the ID token Google issues.
GOOGLE_CLIENT_ID=

# --- LLM (team이 provider를 정한 뒤 채운다) ---
# LLM_PROVIDER: "openai", "gemini" 또는 "upstage" (agent_adapters.create_chat_model() 참고)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# gemini를 쓸 때: LLM_PROVIDER=gemini, LLM_MODEL=gemini-2.5-flash 등으로 바꾸고 아래를 채운다.
# 설치: pip install -e ".[dev,llm-gemini]"
GOOGLE_API_KEY=
# Upstage 채팅 모델을 쓸 때: LLM_PROVIDER=upstage, LLM_MODEL=solar-pro3
# 설치: pip install -e ".[dev,llm-upstage]"
UPSTAGE_API_KEY=
# Advanced hybrid RAG. OpenAI embeddings require the llm-openai extra above.
# Upstage embeddings require llm-upstage and RAG_EMBEDDING_PROVIDER=upstage.
# Set false to fall back to deterministic keyword/source scoring only.
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
UPSTAGE_EMBEDDING_MODEL=solar-embedding-1-large
RAG_EMBEDDING_TIMEOUT_SECONDS=20
# Persistent Evidence Vector Store. Leave QDRANT_URL empty to use the local
# on-disk store; set URL/API key for Qdrant Server or Cloud in production.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_EVIDENCE_COLLECTION=thesisguard_evidence_v1
PORTFOLIO_QA_SEMANTIC_LIMIT=20
# Optional cosine threshold. Leave unset to always return the nearest evidence.
# PORTFOLIO_QA_SCORE_THRESHOLD=0.2
# DB 근거를 종목별 Markdown으로 요약해 프롬프트에 전달하는 파생 파일 저장소
EVIDENCE_HISTORY_DIR=./data/evidence_history
EVIDENCE_HISTORY_MAX_ITEMS=30

# --- Langfuse (optional LLM tracing) ---
# Create a Langfuse project, then copy its project keys here. Never commit the
# real secret key. Set ENABLED=true only after both keys are present.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0
# Temporarily set true only when exporter troubleshooting is needed.
LANGFUSE_DEBUG=false

# --- MCP / 외부 데이터 소스 ---
# SEC EDGAR는 API 키가 필요 없지만, 요청마다 연락 가능한 User-Agent를 요구한다.
SEC_USER_AGENT="ThesisGuard PBL Team <you@example.com>"
# FRED 그래프 CSV 엔드포인트는 키 없이 조회 가능 (거시 데이터: CPI/기준금리/국채금리)
FRED_BASE_URL=https://fred.stlouisfed.org/graph/fredgraph.csv
# 시세는 키 없이 조회 가능한 Yahoo Finance 차트 API 사용 (mcp_tools/market.py에 하드코딩)

# --- 이메일(Alert Engine) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@thesisguard.local
SMTP_USE_TLS=true
# true로 두면 실제 발송 대신 로그로만 출력 (로컬 개발용)
EMAIL_DRY_RUN=true
# In-process worker polling. Run only one scheduler-enabled API replica in MVP.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=60
